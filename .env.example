# Local development only. Copy to .env.local and adjust.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tabulin
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tabulin_test
# At least 32 characters. Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-32chars
SEED_ADMIN_NAME=Admin Sistem
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
# Shared secret the customer app/bank API sends as 'Authorization: Bearer <key>' (min 24 chars)
INTEGRATION_API_KEY=change-me-integration-key-24chars-min
# Sementara: 1 = aktifkan POST /api/integrasi/pasien (buat pasien uji + token). Kosongkan di produksi kecuali sedang menguji.
ALLOW_PASIEN_UJI=
# Midtrans Sandbox (payment gateway checkout + notification). Sandbox server key only.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
# Optional: callback URL sent with every Midtrans charge (overrides the dashboard setting), e.g. https://<host>/api/integrasi/midtrans
MIDTRANS_NOTIFICATION_URL=
# Optional: Midtrans merchant VA prefix (sandbox: 56652). When set, new registrations get VA = prefix + 11 digits and every bill is paid to that same number.
MIDTRANS_VA_PREFIX=

# Faspay through the payment gateway orchestrator (pay-gate). Base URL is the gateway itself, not this app.
FASPAY_BASE_URL=https://pay-gate-orpin.vercel.app
FASPAY_CLIENT_ID=
FASPAY_CLIENT_SECRET=
# Signs the gateway's webhooks to POST /api/integrasi/faspay (HMAC-SHA256). When set, unsigned or stale webhooks are refused.
FASPAY_WEBHOOK_SECRET=
