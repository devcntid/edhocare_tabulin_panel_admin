# Local development only. Copy to .env.local and adjust.
DATABASE_URL=postgresql://alif@localhost:5432/tabulin
TEST_DATABASE_URL=postgresql://alif@localhost:5432/tabulin_test
# At least 32 characters. Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-32chars
SEED_ADMIN_NAME=Admin Sistem
SEED_ADMIN_EMAIL=admin@tabulin.local
SEED_ADMIN_PASSWORD=ChangeMeNow!2026
# Shared secret the customer app/bank API sends as 'Authorization: Bearer <key>' (min 24 chars)
INTEGRATION_API_KEY=change-me-integration-key-24chars-min
